{
  "manifest_version": 3,
  "name": "Izy Focus J",
  "version": "1.5",
  "description": "Uma ferramenta de foco e bloqueio de sites baseada na técnica Pomodoro.",
  "permissions": [
    "storage",
    "tabs",
    "notifications",
    "scripting"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
